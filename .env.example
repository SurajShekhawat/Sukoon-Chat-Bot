# ==============================================================================
# Sukoon AI — Environment Variables Template (.env.example)
# DO NOT commit actual secrets or production keys to source control.
# Copy this file to .env.local and fill in the values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Authentication & PostgreSQL Database)
# Obtain these from your Supabase Project Dashboard -> Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. AI Provider Configuration (Google Gemini / OpenAI / NVIDIA NIM)
# Default Primary: Google Gemini 3.5 Flash-Lite (Recommended)
# Obtain key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI (Requires paid credits)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2.1 NVIDIA NIM Hosted Catalog Configuration
# Base URL: https://integrate.api.nvidia.com/v1
# Obtain key at: https://build.nvidia.com
# NOTE: Free hosted endpoints are DEVELOPMENT_ONLY. Set NVIDIA_DEPLOYMENT_MODE=production
# only when using licensed production enterprise entitlements.
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_CHAT_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_CODING_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_TTS_MODEL=nvidia/magpie-tts-zeroshot
NVIDIA_DEPLOYMENT_MODE=development

# ------------------------------------------------------------------------------
# 3. Application & Deployment Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. Usage Quotas & Rate Limits
# ------------------------------------------------------------------------------
RATE_LIMIT_DAILY_MESSAGES=50
RATE_LIMIT_BURST_PER_MINUTE=15

# ------------------------------------------------------------------------------
# 5. Billing & Webhook Secrets (Optional for Phase 10 Subscriptions)
# ------------------------------------------------------------------------------
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
VOICE_SESSION_SIGNING_SECRET=your-voice-session-signing-secret
